{
	"schemaVersion": 1,
	"id": "${mod_id}",
	"version": "${version}",
	"name": "Infinidye",
	"description": "Phenom-7280 \"Infinidye\" is a para-object that, when applied to a surface, manipulates the object's perceived color.",
	"authors": [
		"Sylv <contact@sylv.gay>"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/infinidye",
		"sources": "https://github.com/sylv256/infinidye"
	},
	"license": "LGPL-3.0",
	"icon": "assets/${mod_id}/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"gay.sylv.infinidye.Infinidye"
		],
		"client": [
			"gay.sylv.infinidye.client.InfinidyeClient"
		],
		"fabric-datagen": [
			"gay.sylv.infinidye.client.InfinidyeDataGenerator"
		],
		"frappe-ext-terrain-material:registry": [
			"gay.sylv.infinidye.client.frappe.FrappeEntrypoints"
		]
	},
	"mixins": [
		"infinidye.mixins.json",
		{
			"config": "infinidye.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"custom": {
		"frappe": {
			"schemaVersion": 0,
			"override": true,
			"config": {
				"frappe-ext-terrain-material.enabled": true
			}
		}
	}
}
